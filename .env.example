# Copy to .env and fill in. Never commit .env.

# --- App ---------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
# Single tenant for now; every row still carries client_id.
DEFAULT_CLIENT_ID=missan

# --- Postgres (docker-compose) -------------------------------------------------
POSTGRES_USER=clearbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clearbook
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (docker-compose) ----------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Celery job limits (seconds). Visibility timeout must exceed the time limit.
JOB_TIME_LIMIT_SECONDS=1800
JOB_VISIBILITY_TIMEOUT_SECONDS=3600

# --- Files ---------------------------------------------------------------------
# Places the Run screen may pick folders in (decision 35), as a JSON list. Default: your home
# folder and the shared drives. A client's own folder (if set) is offered too.
# FOLDER_PLACES='["/Users/me", "/Volumes"]'
STORE_DIR=data/store
# Live only (decision 77): the built Workbench, served with the API under /api. Empty in development.
# WEB_DIST_DIR=workbench/dist
# Folders uploaded from the accountants' own computers (decision 78), and the limits per upload
UPLOAD_DIR=data/uploads
MAX_UPLOAD_FILES=1000
MAX_UPLOAD_MB=1024
MAX_FILE_MB=25
STABLE_FILE_SECONDS=2

# --- Read / OCR (task 2.4) ---------------------------------------------------------
MAX_PAGES=20
PAGE_IMAGE_MAX_SIDE=1500
TEXT_LAYER_MIN_CHARS=20
# PaddleOCR model files (downloaded once from Hugging Face, ~100-170 MB; bundle for offline prod)
OCR_MODELS_DIR=data/models/paddlex
# Mobile = fast on CPU; on a GPU server consider PP-OCRv5_server_det / PP-OCRv5_server_rec
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec

# --- Model (LM Studio in dev, vLLM in prod; decisions 3, 46) ----------------------
# lmstudio (MLX, default on the Mac) or ollama (LLM_BASE_URL=http://localhost:11434,
# LLM_MODEL=qwen3-vl:4b-instruct)
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234
LLM_MODEL=qwen/qwen3-vl-4b
# LM Studio fixes the context when it loads the model: load it with `make llm-load`.
LLM_CONTEXT_TOKENS=16384
# Decision 80: a file never holds the queue for long (raise both for a slow CPU-only server)
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=3000
# Page images per document sent to the model (text goes for every page)
EXTRACT_MAX_IMAGES=3

# --- Validation tolerances (task 3.2) ----------------------------------------------
# VAT may differ from 5% by this much per line (shops round VAT per item)
VAT_TOLERANCE_PER_LINE=0.01
# Warn if a document is more than this many days older than its inbox folder date
PERIOD_MAX_DAYS_BEFORE=90
# A document dated more than this many days after today is an error (misread date)
FUTURE_DATE_SLACK_DAYS=1

# --- Supplier match (task 3.5) -----------------------------------------------------
# Whose master data the (single, for now) client is matched against: MANUAL or XERO
ACCOUNTING_PROVIDER=MANUAL
# Name similarity 0-1: match at or above, suggest a possible match at or above
VENDOR_MATCH_MIN_SIMILARITY=0.6
VENDOR_SUGGEST_MIN_SIMILARITY=0.35
# Coding: use a supplier's learned account after this many consistent approvals
CODING_MIN_CONSISTENT_APPROVALS=2
# Business date for date checks (IANA time zone), not the server's clock
BUSINESS_TIMEZONE=Asia/Dubai

# --- Xero adapter (optional, Phase 5) -------------------------------------------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/xero/callback
# Granular scopes (Xero apps created after 2 March 2026); default in config.py
# XERO_SCOPES=offline_access accounting.settings accounting.contacts accounting.invoices accounting.payments accounting.banktransactions accounting.attachments
# Encrypts stored accounting system tokens. Create with: make secret-key (never commit it)
TOKEN_KEY=

# --- Zoho Books adapter (optional, decision 74) ------------------------------------
# A server-based client at api-console.zoho.com; in its Settings, Multi-DC with the same
# credentials for all data centres. Add https://<domain>/zoho/callback for production.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/zoho/callback

# --- SharePoint, read only (optional, decision 83) ----------------------------------
# An app registration in Missan's Microsoft Entra ID (Web platform, single tenant) with the
# delegated permissions User.Read, offline_access, Sites.Read.All, Files.Read.All. Redirect URIs:
# http://localhost:8000/sharepoint/callback (development), https://<address>/api/sharepoint/callback
# (live). The client secret expires (24 months): make a new one in Entra ID before it does.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_REDIRECT_URI=http://localhost:8000/sharepoint/callback

# Where the browser returns after connecting an accounting system or SharePoint
WORKBENCH_URL=http://127.0.0.1:5173

# --- Login (Phase 6, decision 71) ------------------------------------------------
# Signs the session cookie. Create with: make jwt-secret (never commit it). Login is refused
# while it is empty, the placeholder or shorter than 32 characters.
JWT_SECRET=
SESSION_HOURS=24
# true in production (HTTPS only); false only for http://127.0.0.1 in development
COOKIE_SECURE=false

# Work out a line's unit price when only its total is printed, if the numbers prove it (decision 44)
REPAIR_UNIT_PRICES=true
