# Copy to .env and fill in. Never commit .env.

# --- App ---------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
# Single tenant for now; every row still carries client_id.
DEFAULT_CLIENT_ID=missan

# --- Postgres (docker-compose) -------------------------------------------------
POSTGRES_USER=clearbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clearbook
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (docker-compose) ----------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Files ---------------------------------------------------------------------
INBOX_DIR=data/inbox
STORE_DIR=data/store

# --- Model (Ollama native in dev, vLLM in prod; OpenAI-compatible) --------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3-vl:4b

# --- Xero (task 1.5) -----------------------------------------------------------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/xero/callback

# --- Auth (task 4.1) -----------------------------------------------------------
JWT_SECRET=change-me
