{
  "components": {
    "schemas": {
      "ClientOut": {
        "properties": {
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "name"
        ],
        "title": "ClientOut",
        "type": "object"
      },
      "DocumentType": {
        "enum": [
          "BILL",
          "CREDIT_NOTE",
          "DEBIT_NOTE",
          "RECEIPT",
          "SALES_INVOICE",
          "NON_POSTABLE"
        ],
        "title": "DocumentType",
        "type": "string"
      },
      "FileStatus": {
        "properties": {
          "document_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "document_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentType"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "file": {
            "title": "File",
            "type": "string"
          },
          "from_earlier_run": {
            "title": "From Earlier Run",
            "type": "boolean"
          },
          "pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pages"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "file",
          "status",
          "document_id",
          "document_type",
          "pages",
          "failure_reason",
          "from_earlier_run"
        ],
        "title": "FileStatus",
        "type": "object"
      },
      "Folder": {
        "properties": {
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "date"
        ],
        "title": "Folder",
        "type": "object"
      },
      "FolderListing": {
        "properties": {
          "folders": {
            "items": {
              "$ref": "#/components/schemas/Folder"
            },
            "title": "Folders",
            "type": "array"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "folders"
        ],
        "title": "FolderListing",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Liveness": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Liveness",
        "type": "object"
      },
      "ModelStatus": {
        "description": "Is the configured model ready to extract? (decision 2: Instruct, with vision)",
        "enum": [
          "ok",
          "unreachable",
          "missing",
          "incompatible"
        ],
        "title": "ModelStatus",
        "type": "string"
      },
      "Readiness": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/ModelStatus"
          },
          "redis": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Redis",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "redis",
          "model"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "RunAccepted": {
        "properties": {
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "folder_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Folder Date"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        },
        "required": [
          "run_id",
          "status",
          "folder",
          "folder_date"
        ],
        "title": "RunAccepted",
        "type": "object"
      },
      "RunCreate": {
        "properties": {
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "folder": {
            "default": "",
            "description": "Inside the client's folder; '' = all of it",
            "title": "Folder",
            "type": "string"
          },
          "folder_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Confirmed on the Run screen; default: read from the folder",
            "title": "Folder Date"
          }
        },
        "required": [
          "client_id"
        ],
        "title": "RunCreate",
        "type": "object"
      },
      "RunProgressOut": {
        "properties": {
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Counts",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileStatus"
            },
            "title": "Files",
            "type": "array"
          },
          "files_found": {
            "title": "Files Found",
            "type": "integer"
          },
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "folder_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Folder Date"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RunState"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        },
        "required": [
          "run_id",
          "client_id",
          "folder",
          "folder_date",
          "status",
          "failure_reason",
          "state",
          "created_at",
          "files_found",
          "counts",
          "files"
        ],
        "title": "RunProgressOut",
        "type": "object"
      },
      "RunState": {
        "enum": [
          "scanning",
          "processing",
          "finished"
        ],
        "title": "RunState",
        "type": "string"
      },
      "RunStatus": {
        "enum": [
          "RUNNING",
          "COMPLETED",
          "FAILED"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "invoice-clearbook",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/clients": {
      "get": {
        "operationId": "get_clients_clients_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClientOut"
                  },
                  "title": "Response Get Clients Clients Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Clients",
        "tags": [
          "clients"
        ]
      }
    },
    "/clients/{client_id}/folders": {
      "get": {
        "operationId": "get_folders_clients__client_id__folders_get",
        "parameters": [
          {
            "in": "path",
            "name": "client_id",
            "required": true,
            "schema": {
              "title": "Client Id",
              "type": "string"
            }
          },
          {
            "description": "Folder inside the client's folder",
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "default": "",
              "description": "Folder inside the client's folder",
              "title": "Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderListing"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Folders",
        "tags": [
          "clients"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "The process is up. Checks no dependencies.",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Postgres and Redis decide readiness (503 if either is down). The model is reported\ntoo (installed, Instruct, with vision), but does not make the API unready.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/runs": {
      "post": {
        "operationId": "create_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}": {
      "get": {
        "description": "Live progress, per file the scan found.",
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunProgressOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run",
        "tags": [
          "runs"
        ]
      }
    }
  }
}
